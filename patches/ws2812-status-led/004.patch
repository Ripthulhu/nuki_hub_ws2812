diff --git a/src/Ws2812StatusLed.h b/src/Ws2812StatusLed.h
new file mode 100644
index 0000000..7a0899c
--- /dev/null
+++ b/src/Ws2812StatusLed.h
@@ -0,0 +1,143 @@
+#pragma once
+
+#include <Preferences.h>
+#include <cstdint>
+
+enum class Ws2812Trigger : uint8_t
+{
+    Startup,
+    NetworkConnected,
+    MqttConnected,
+    BluetoothComm,
+    BluetoothCommError,
+    LockLocked,
+    LockUnlocked,
+    LockMotorBlocked,
+    RtoActive,
+    CmActive,
+    RtoOrCmActive,
+    DoorbellRing,
+    GeneralInput,
+    Count
+};
+
+enum class Ws2812Effect : uint8_t
+{
+    Disabled,
+    Off,
+    SolidGreen,
+    SolidRed,
+    SolidBlue,
+    SolidAmber,
+    SolidWhite,
+    BlinkGreen,
+    BlinkRed,
+    BlinkBlue,
+    BlinkAmber,
+    FlashWhite,
+    FlashGreen,
+    FlashRed,
+    FlashBlue,
+    PulseBlue,
+    PulseGreen,
+    Rainbow,
+    BlinkWhite,
+    PulseWhite,
+    PulseAmber,
+    DoubleFlashWhite,
+    DoubleFlashRed,
+    PoliceRedBlue,
+    LegacyRainbowFast,
+    BreathBlue,
+    BreathGreen,
+    BreathAmber,
+    BreathWhite,
+    HeartbeatWhite,
+    HeartbeatRed,
+    TwinkleWhite,
+    FireFlicker,
+    PrismSprint,
+    RainbowBeat,
+    PartySparkle,
+    ColorBurst,
+    ElectricZap,
+    Count
+};
+
+constexpr uint8_t WS2812_TRIGGER_COUNT = static_cast<uint8_t>(Ws2812Trigger::Count);
+constexpr uint8_t WS2812_EFFECT_COUNT = static_cast<uint8_t>(Ws2812Effect::Count);
+
+class Ws2812StatusLed
+{
+public:
+    explicit Ws2812StatusLed(Preferences* preferences);
+    ~Ws2812StatusLed();
+
+    void begin();
+    void reload();
+    void update();
+    void test();
+
+    void trigger(Ws2812Trigger trigger);
+    void setTriggerState(Ws2812Trigger trigger, bool active);
+
+    bool enabled() const;
+    int pin() const;
+    uint8_t brightness() const;
+
+    Ws2812Effect effectForTrigger(Ws2812Trigger trigger) const;
+
+    static const char* getTriggerDescription(Ws2812Trigger trigger);
+    static const char* getEffectDescription(Ws2812Effect effect);
+    static Ws2812Effect defaultEffectForTrigger(Ws2812Trigger trigger);
+    static void loadEffects(Preferences* preferences, Ws2812Effect effects[WS2812_TRIGGER_COUNT]);
+    static void saveEffects(Preferences* preferences, const Ws2812Effect effects[WS2812_TRIGGER_COUNT]);
+    static void loadBrightnesses(Preferences* preferences, uint8_t brightnesses[WS2812_TRIGGER_COUNT], uint8_t defaultBrightness = 32);
+    static void saveBrightnesses(Preferences* preferences, const uint8_t brightnesses[WS2812_TRIGGER_COUNT]);
+
+private:
+    void loadSettings();
+    bool configureStrip();
+    void deleteStrip();
+    void clear();
+    void render(Ws2812Effect effect, int64_t now);
+    void renderBlink(uint8_t red, uint8_t green, uint8_t blue, uint16_t periodMs, int64_t now);
+    void renderShortBlink(uint8_t red, uint8_t green, uint8_t blue, uint16_t intervalMs, uint16_t onMs, int64_t now);
+    void renderPulse(uint8_t red, uint8_t green, uint8_t blue, uint16_t periodMs, int64_t now);
+    void renderBreath(uint8_t red, uint8_t green, uint8_t blue, uint16_t periodMs, int64_t now);
+    void renderHeartbeat(uint8_t red, uint8_t green, uint8_t blue, uint16_t periodMs, int64_t now);
+    void renderTwinkle(uint8_t red, uint8_t green, uint8_t blue, uint16_t periodMs, int64_t now);
+    void renderFireFlicker(int64_t now);
+    void renderPrismSprint(int64_t now);
+    void renderRainbowBeat(int64_t now);
+    void renderPartySparkle(int64_t now);
+    void renderColorBurst(int64_t now);
+    void renderElectricZap(int64_t now);
+    void renderDoubleFlash(uint8_t red, uint8_t green, uint8_t blue, uint16_t cycleMs, int64_t now);
+    void renderPoliceRedBlue(uint16_t cycleMs, int64_t now);
+    void setHsv(uint16_t hue, uint8_t saturation, uint8_t value);
+    void setColor(uint8_t red, uint8_t green, uint8_t blue);
+    void setColorScaled(uint8_t red, uint8_t green, uint8_t blue, uint8_t scale);
+    Ws2812Effect currentEffect(int64_t now, uint8_t& brightness);
+    uint16_t momentaryDuration(Ws2812Trigger trigger, Ws2812Effect effect) const;
+
+    Preferences* _preferences = nullptr;
+    void* _updateMutex = nullptr;
+    void* _strip = nullptr;
+    int _pin = -1;
+    int _activePin = -1;
+    uint8_t _defaultBrightness = 32;
+    uint8_t _brightness = 32;
+    Ws2812Effect _effects[WS2812_TRIGGER_COUNT] = {};
+    uint8_t _triggerBrightness[WS2812_TRIGGER_COUNT] = {};
+    bool _activeTriggers[WS2812_TRIGGER_COUNT] = {};
+    Ws2812Effect _momentaryEffect = Ws2812Effect::Disabled;
+    uint8_t _momentaryBrightness = 32;
+    int64_t _momentaryStartedAt = 0;
+    int64_t _momentaryUntil = 0;
+    bool _shortBlinkActive = false;
+    int64_t _shortBlinkNextAt = 0;
+    int64_t _shortBlinkOffAt = 0;
+    int64_t _lastRefresh = 0;
+    uint32_t _lastColor = 0xffffffff;
+};
