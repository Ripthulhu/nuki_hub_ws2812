+void Gpio::startWs2812Task()
+{
+    if(_ws2812 == nullptr || _ws2812Task != nullptr)
+    {
+        return;
+    }
+
+    xTaskCreate(ws2812Task, "ws2812", 3072, this, 1, &_ws2812Task);
+}
+
+void Gpio::ws2812Task(void* parameter)
+{
+    Gpio* gpio = static_cast<Gpio*>(parameter);
+    while(true)
+    {
+        if(gpio != nullptr && gpio->_ws2812 != nullptr)
+        {
+            gpio->_ws2812->update();
+        }
+        vTaskDelay(pdMS_TO_TICKS(10));
+    }
+}
