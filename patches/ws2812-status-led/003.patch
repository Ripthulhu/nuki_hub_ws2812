+Ws2812Effect Ws2812StatusLed::defaultEffectForTrigger(Ws2812Trigger trigger)
+{
+    switch(trigger)
+    {
+    case Ws2812Trigger::Startup:
+        return Ws2812Effect::FlashGreen;
+    case Ws2812Trigger::BluetoothComm:
+        return Ws2812Effect::PulseBlue;
+    case Ws2812Trigger::BluetoothCommError:
+    case Ws2812Trigger::LockMotorBlocked:
+        return Ws2812Effect::FlashRed;
+    case Ws2812Trigger::DoorbellRing:
+        return Ws2812Effect::DoubleFlashWhite;
+    case Ws2812Trigger::GeneralInput:
+        return Ws2812Effect::FlashBlue;
+    default:
+        return Ws2812Effect::Disabled;
+    }
+}
+
+void Ws2812StatusLed::loadEffects(Preferences* preferences, Ws2812Effect effects[WS2812_TRIGGER_COUNT])
+{
+    for(uint8_t i = 0; i < WS2812_TRIGGER_COUNT; i++)
+    {
+        effects[i] = defaultEffectForTrigger(static_cast<Ws2812Trigger>(i));
+    }
+
+    size_t storedLength = preferences->getBytesLength(preference_ws2812_effects);
+    if(storedLength == 0)
+    {
+        return;
+    }
+
+    uint8_t serialized[WS2812_TRIGGER_COUNT] = {};
+    size_t size = preferences->getBytes(preference_ws2812_effects, serialized, sizeof(serialized));
+    for(uint8_t i = 0; i < size && i < WS2812_TRIGGER_COUNT; i++)
+    {
+        if(serialized[i] == LEGACY_RAINBOW_FAST_EFFECT)
+        {
+            effects[i] = Ws2812Effect::Rainbow;
+        }
+        else if(serialized[i] < WS2812_EFFECT_COUNT)
+        {
+            effects[i] = static_cast<Ws2812Effect>(serialized[i]);
+        }
+    }
+}
+
+void Ws2812StatusLed::saveEffects(Preferences* preferences, const Ws2812Effect effects[WS2812_TRIGGER_COUNT])
+{
+    uint8_t serialized[WS2812_TRIGGER_COUNT] = {};
+    for(uint8_t i = 0; i < WS2812_TRIGGER_COUNT; i++)
+    {
+        serialized[i] = static_cast<uint8_t>(effects[i]);
+    }
+
+    preferences->putBytes(preference_ws2812_effects, serialized, sizeof(serialized));
+}
+
+void Ws2812StatusLed::loadBrightnesses(Preferences* preferences, uint8_t brightnesses[WS2812_TRIGGER_COUNT], uint8_t defaultBrightness)
+{
+    uint8_t normalizedDefault = clampBrightness(defaultBrightness);
+    for(uint8_t i = 0; i < WS2812_TRIGGER_COUNT; i++)
+    {
+        brightnesses[i] = normalizedDefault;
+    }
+
+    size_t storedLength = preferences->getBytesLength(preference_ws2812_brightnesses);
+    if(storedLength == 0)
+    {
+        return;
+    }
+
+    uint8_t serialized[WS2812_TRIGGER_COUNT] = {};
+    size_t size = preferences->getBytes(preference_ws2812_brightnesses, serialized, sizeof(serialized));
+    for(uint8_t i = 0; i < size && i < WS2812_TRIGGER_COUNT; i++)
+    {
+        if(serialized[i] > 0)
+        {
+            brightnesses[i] = serialized[i];
+        }
+    }
+}
+
+void Ws2812StatusLed::saveBrightnesses(Preferences* preferences, const uint8_t brightnesses[WS2812_TRIGGER_COUNT])
+{
+    uint8_t serialized[WS2812_TRIGGER_COUNT] = {};
+    for(uint8_t i = 0; i < WS2812_TRIGGER_COUNT; i++)
+    {
+        serialized[i] = clampBrightness(brightnesses[i]);
+    }
+
+    preferences->putBytes(preference_ws2812_brightnesses, serialized, sizeof(serialized));
+}
